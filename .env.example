# Apiary configuration for docker compose. Copy to .env and fill in every value marked
# "required". Never commit .env.

# --- Database ---------------------------------------------------------------------
# Password of the apiary role in the bundled Postgres (used by the postgres service).
POSTGRES_PASSWORD=change-me
# Connection URL Apiary uses; the password must match POSTGRES_PASSWORD. Required.
DATABASE_URL=ecto://apiary:change-me@postgres/apiary
# Connections in the pool (optional, default 10).
# POOL_SIZE=10
# Set to true when the database host resolves to IPv6 only (optional).
# ECTO_IPV6=false
# Run pending migrations at boot (default true); false leaves them to bin/migrate.
# MIGRATE_ON_BOOT=true

# --- Secret key base ----------------------------------------------------------------
# Signs and encrypts cookies and tokens; at least 64 characters. Required.
# Generate: openssl rand -base64 48   (or, in a checkout, mix phx.gen.secret)
SECRET_KEY_BASE=

# --- Encryption key -----------------------------------------------------------------
# Encrypts secrets at rest (access key secrets); 32 bytes in base64. Required.
# Generate: openssl rand -base64 32   Keep it with your database backups.
CLOAK_KEY=

# --- Public URL and port ------------------------------------------------------------
# The address people and runners use to reach Apiary, with scheme. Required.
PUBLIC_URL=https://apiary.example.com
# Port the release listens on inside the container (optional, default 4100).
# PORT=4100

# --- Mail ---------------------------------------------------------------------------
# SMTP relay host. Required, unless MAIL_TO_LOG=true below: the release does not boot
# without a way to deliver mail.
SMTP_RELAY=
# For a trial on one machine only: with no SMTP_RELAY, write every email to the log in
# full instead of sending it. WARNING: log-in links and invitation links are credentials,
# and with this setting they reach the log and everyone and everything that reads it.
# Never set it on an installation other people sign in to.
# MAIL_TO_LOG=true
# Relay port (optional, default 587; 465 means implicit TLS).
# SMTP_PORT=587
# Relay credentials (optional; no username means no authentication).
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS policy: always (default), if_available or never.
# SMTP_TLS=always
# Sender address of every email (optional, default apiary@<host of PUBLIC_URL>).
# MAIL_FROM=apiary@example.com

# --- Clustering (optional) ------------------------------------------------------------
# DNS name whose A/AAAA records list the other nodes to cluster with.
# DNS_CLUSTER_QUERY=
