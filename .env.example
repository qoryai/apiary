# Qory Apiary, run by compose.yaml beside this file. Copy it to .env and set what your
# installation needs. Never commit .env.
#
# SECRET_KEY_BASE, APIARY_ENCRYPTION_SECRET, APIARY_SIGNING_SECRET and the database
# password are generated at first start and kept in the volume `keys`
# (/var/lib/apiary/keys/apiary.env). Set one here only for a value you bring, such as one
# restored from a backup: a value here always wins.

# --- Version ------------------------------------------------------------------------
# The release to run, for example 0.2.0: its version, without the v. The copy of this file
# attached to a release names that release here. To upgrade, set the new release, then:
#   docker compose pull && docker compose up -d
APIARY_VERSION=
# APIARY_IMAGE=ghcr.io/qoryai/apiary

# --- Database -----------------------------------------------------------------------
# postgres runs the bundled Postgres. To use another one instead, remove this line and set
# DATABASE_URL below.
COMPOSE_PROFILES=postgres
# Another Postgres, with TLS as your provider gives it, for example:
#   postgres://USER:PASS@HOST:5432/DATABASE?sslmode=verify-full
# sslmode=verify-full checks the server's certificate against the system's CAs, or against
# sslrootcert=/path/to/ca.pem; sslmode=require encrypts without checking it.
# DATABASE_URL=
# Connections in the pool (optional, default 10).
# POOL_SIZE=10
# Set to true when the database host resolves to IPv6 only (optional).
# ECTO_IPV6=false
# Run pending migrations at start (default true); false leaves them to bin/migrate.
# MIGRATE_ON_BOOT=true

# --- Public URL ---------------------------------------------------------------------
# The address people and machines use to reach Qory: scheme and host, a port when it has
# one, no path. https, or http only for a trial on this machine: Forager refuses plain
# http to any other host. compose.yaml publishes port 4100 on 127.0.0.1 only, for a
# reverse proxy on this machine.
PUBLIC_URL=http://localhost:4100
# The reverse proxy in front of Qory Apiary, as the address its connections come from
# (optional; addresses or CIDR ranges, separated by commas). Unset, every client counts as
# the proxy and they share its limits on signing in. For a proxy on this machine it is the
# gateway of the network qory_default: docker network inspect qory_default
# TRUSTED_PROXIES=

# --- Mail (optional) ------------------------------------------------------------------
# Mail (optional). Set it here, or later in Qory under Instance settings › Mail. Without
# mail, Qory Apiary starts and sends no email, and its log says so: people sign in with a
# password, and invitations and password links are copied by hand.
#
# SMTP relay host. Set here, it wins over the settings saved in Qory.
SMTP_RELAY=
# Relay port (optional, default 587; 465 means implicit TLS).
# SMTP_PORT=587
# Relay credentials (optional; no username means no authentication).
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS policy: always (default), if_available or never. With a username, keep it
# always (or use port 465): the others can send the password unencrypted. TLS checks the
# relay's certificate and host name.
# SMTP_TLS=always
# Sender address of every email (optional, default qory@<host of PUBLIC_URL>).
# MAIL_FROM=qory@example.com

# --- Clustering (optional) ------------------------------------------------------------
# DNS name whose A/AAAA records list the other nodes to cluster with.
# DNS_CLUSTER_QUERY=
# Required with DNS_CLUSTER_QUERY: the secret the nodes connect with, the same long random
# value on every node, for example from openssl rand -base64 32. Use printable ASCII on one
# line only.
# RELEASE_COOKIE=

# --- GitHub adapter (optional) --------------------------------------------------------
# The service `github` in compose.yaml; its comments there say what turning it on needs.
# The adapters installed with Qory Apiary, separated by commas: github for this one.
# QORY_INSTALLED_ADAPTERS=github
# The adapter's public address, https, on a host name apart from PUBLIC_URL's.
# QORY_GITHUB_PUBLIC_URL=https://github.example.com
# The host port the adapter is published on, 8080 unless set.
# QORY_GITHUB_HOST_PORT=8080
# The adapter's image (optional, default ghcr.io/qoryai/qory-github-server).
# QORY_GITHUB_IMAGE=ghcr.io/qoryai/qory-github-server
