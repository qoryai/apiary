# Qory Apiary, run by compose.yaml beside this file. Copy it to .env and set what your
# installation needs. Never commit .env.
#
# SECRET_KEY_BASE, APIARY_ENCRYPTION_SECRET, APIARY_SIGNING_SECRET and the database
# password are generated at first start and kept in the volume `keys`
# (/var/lib/apiary/keys/apiary.env). Set one here only for a value of your own, such as one
# restored from a backup: a value here always wins.

# --- Version ------------------------------------------------------------------------
# The release to run, for example 0.2.0: its version, without the v. The copy of this file
# attached to a release names that release here. To upgrade, set the new release, then:
#   docker compose pull && docker compose up -d
APIARY_VERSION=
# The image. Qory Apiary Pro's is ghcr.io/qoryai/apiary-pro (optional).
# APIARY_IMAGE=ghcr.io/qoryai/apiary

# --- Database -----------------------------------------------------------------------
# postgres runs the bundled Postgres. To use your own instead, remove this line and set
# DATABASE_URL below.
COMPOSE_PROFILES=postgres
# Your own Postgres, with TLS as your provider gives it, for example:
#   postgres://USER:PASS@HOST:5432/DATABASE?sslmode=verify-full
# sslmode=verify-full checks the server's certificate against the system's CAs, or against
# sslrootcert=/path/to/ca.pem; sslmode=require encrypts without checking it.
# DATABASE_URL=
# Connections in the pool (optional, default 10).
# POOL_SIZE=10
# Set to true when the database host resolves to IPv6 only (optional).
# ECTO_IPV6=false
# Run pending migrations at start (default true); false leaves them to bin/migrate.
# MIGRATE_ON_BOOT=true

# --- Public URL ---------------------------------------------------------------------
# The address people and machines use to reach Qory: scheme and host, a port when it has
# one, no path. https, or http only for a trial on this machine: Forager refuses plain
# http to any other host. compose.yaml publishes port 4100 on 127.0.0.1 only, for a
# reverse proxy on this machine.
PUBLIC_URL=http://localhost:4100

# --- Mail ---------------------------------------------------------------------------
# SMTP relay host. Required, unless MAIL_TO_LOG=true below: Qory does not start without a
# way to deliver mail.
SMTP_RELAY=
# For a trial on one machine only: with no SMTP_RELAY, write every email to the log in
# full instead of sending it. WARNING: log-in links and invitation links are credentials,
# and with this setting they reach the log and everyone and everything that reads it.
# Never set it on an installation other people sign in to.
# MAIL_TO_LOG=true
# Relay port (optional, default 587; 465 means implicit TLS).
# SMTP_PORT=587
# Relay credentials (optional; no username means no authentication).
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS policy: always (default), if_available or never.
# SMTP_TLS=always
# Sender address of every email (optional, default qory@<host of PUBLIC_URL>).
# MAIL_FROM=qory@example.com

# --- First administrator (optional) --------------------------------------------------
# Your address. Used once, at the first start: the log-in link goes to this address.
FIRST_ADMIN_EMAIL=
# Your organisation's name. Leave both empty for the first sign-up on the web instead.
FIRST_ORGANISATION_NAME=

# --- Integrations (optional) ----------------------------------------------------------
# Integrations are added from releases on github.com, gitlab.com and codeberg.org, or from
# an https address of their description.json, and are fetched from public addresses only.
# Self-hosted forges are not supported.
#
# Whether an integration may be added from an https address of its description.json
# (default true). Set it to false on an instance open to people you do not know, such as
# a cloud one, so that integrations are added from forges' releases alone. A release's
# download links, which its author chooses on GitLab and Codeberg, are still followed to
# any public https host.
# INTEGRATION_URL_SOURCES=true

# --- Clustering (optional) ------------------------------------------------------------
# DNS name whose A/AAAA records list the other nodes to cluster with.
# DNS_CLUSTER_QUERY=
