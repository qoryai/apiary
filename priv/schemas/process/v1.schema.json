{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/apiary/process/v1.schema.json",
  "title": "Process",
  "description": "A workspace's process: its stages in order, and each stage's inputs, sequence of workflows, outputs and gate. Each save is a version. Fields this schema does not list are kept as they are.",
  "type": "object",
  "required": ["schema", "stages"],
  "properties": {
    "schema": {"const": "qory.process/v1"},
    "machine": {
      "description": "The machine type of every workflow entry that sets none: the workspace's default.",
      "$ref": "#/$defs/machine"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["id", "name", "sequence", "gate"],
      "properties": {
        "id": {
          "description": "Minted once, `st_` and 10 Crockford base32 characters, and never changed.",
          "type": "string",
          "pattern": "^st_[0-9a-hjkmnp-tv-z]{10}$"
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S"},
        "inputs": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/input"}
        },
        "sequence": {
          "type": "array",
          "maxItems": 20,
          "items": {"oneOf": [{"$ref": "#/$defs/workflow_entry"}, {"$ref": "#/$defs/loop_entry"}]}
        },
        "outputs": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/output"}
        },
        "gate": {"$ref": "#/$defs/gate"}
      }
    },
    "workflow_entry": {
      "type": "object",
      "required": ["workflow"],
      "not": {"required": ["loop"]},
      "properties": {
        "workflow": {"$ref": "#/$defs/workflow_name"},
        "machine": {"$ref": "#/$defs/machine"},
        "time_limit": {
          "description": "At most the time limit the stack declares for the workflow, as hours, minutes and seconds: 1h30m.",
          "type": "string",
          "pattern": "^(?=.)([0-9]{1,3}h)?([0-9]{1,4}m)?([0-9]{1,5}s)?$"
        },
        "access": {
          "description": "Lowers the access level the stack declares.",
          "const": "read"
        }
      }
    },
    "loop_entry": {
      "type": "object",
      "required": ["loop"],
      "not": {"required": ["workflow"]},
      "properties": {
        "loop": {
          "type": "object",
          "required": ["rounds", "body"],
          "properties": {
            "rounds": {"type": "integer", "minimum": 1, "maximum": 10},
            "body": {
              "description": "Workflow entries only: loops do not nest.",
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {"$ref": "#/$defs/workflow_entry"}
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["type", "required"],
      "properties": {
        "type": {"$ref": "#/$defs/artifact_type"},
        "required": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "required": ["type", "required"],
      "properties": {
        "type": {"$ref": "#/$defs/artifact_type"},
        "required": {"type": "boolean"},
        "check": {
          "description": "How the output is checked: it exists, the default, or an adapter reported an outcome for it. A reported check is stored and not checked in this version.",
          "oneOf": [
            {
              "type": "object",
              "required": ["exists"],
              "not": {"required": ["reported"]},
              "properties": {"exists": {"const": true}}
            },
            {
              "type": "object",
              "required": ["reported"],
              "not": {"required": ["exists"]},
              "properties": {"reported": {"$ref": "#/$defs/outcome"}}
            }
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["person", "none"]},
        "approvers": {
          "oneOf": [
            {"const": "members"},
            {
              "type": "object",
              "required": ["members"],
              "properties": {
                "members": {
                  "description": "The ids of the people who approve, from the users table.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 64}
                }
              }
            }
          ]
        }
      }
    },
    "workflow_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "artifact_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "outcome": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "machine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
