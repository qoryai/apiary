      "models": [
        {"id": "claude-opus-5-5", "title": "Claude Opus 5.5", "effort": ["low", "medium", "high", "xhigh", "max"]},
        {"id": "claude-sonnet-5-5", "title": "Claude Sonnet 5.5", "effort": ["low", "medium", "high", "xhigh", "max"]},
        {"id": "claude-haiku-5-5", "title": "Claude Haiku 5.5", "effort": ["low", "medium", "high", "xhigh", "max"]},
        {"id": "claude-fable-5-1", "title": "Claude Fable 5.1", "effort": ["low", "medium", "high", "xhigh", "max"]}
      ]
    }
  }
}
