{
  "version": 1,
  "name": "acme-tracker",
  "title": "Acme tracker",
  "publisher": {"name": "Acme", "url": "https://acme.example"},
  "description": "Issues of the Acme tracker: an access token for a run's project, and the tracker's MCP server.",
  "program_version": "0.3.0",
  "settings": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "url": {"title": "Tracker", "type": "string", "pattern": "^https://"},
      "project": {"title": "Default project", "type": "string"},
      "api_key": {"title": "API key", "type": "string", "writeOnly": true, "x-secret-name": "ACME_TRACKER_API_KEY"},
      "api_key_file": {"title": "API key file", "type": "string"},
      "mcp_key": {"title": "MCP key", "type": "string", "writeOnly": true, "x-secret-name": "ACME_TRACKER_MCP_KEY"},
      "mcp_key_file": {"title": "MCP key file", "type": "string"}
    }
  },
  "roles": {
    "credential": {"argument": "[A-Z]+", "hosts": ["tracker.acme.example"],
                   "settings": ["url", "api_key"], "required": ["url", "api_key"]},
    "tool": {"argument": "[A-Z]+", "serves": ["mcp.tracker.acme.example"], "mcp": "https://mcp.tracker.acme.example/mcp",
             "placeholders": ["TRACKER_MCP_KEY"], "settings": ["url", "mcp_key", "project"], "required": ["url", "mcp_key"]}
  }
}
