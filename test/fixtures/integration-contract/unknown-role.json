{
  "version": 1,
  "name": "acme-tracker",
  "title": "Acme tracker",
  "description": "Issues of the Acme tracker.",
  "program_version": "0.2.0",
  "settings": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "url": {"type": "string"},
      "token_file": {"type": "string"},
      "token": {"title": "Access token", "type": "string", "writeOnly": true}
    }
  },
  "roles": {
    "credential": {"argument": "[A-Z]+", "hosts": ["tracker.acme.example"]},
    "acme_role": {"events": ["issue.opened"]}
  }
}
