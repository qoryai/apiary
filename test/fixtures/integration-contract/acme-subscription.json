{
  "version": 1,
  "name": "acme-subscription",
  "title": "Acme subscription",
  "description": "Models of an Acme subscription, whose use Acme limits per window.",
  "vendor": "Acme",
  "settings": {"type": "object"},
  "roles": {
    "model_provider": {
      "apis": [
        {"format": "anthropic-messages", "endpoint": "https://api.acme.example", "auth": {"scheme": "bearer", "oauth": true},
         "runtimes": ["claude"], "paths": ["/v1/messages", "/v1/models/*"],
         "oauth_refresh": {"url": "https://auth.acme.example/oauth/token", "client_id": "acme-cli", "scope": "openid profile email"},
         "oauth_device": {"usercode_url": "https://auth.acme.example/device/usercode", "poll_url": "https://auth.acme.example/device/token",
                          "verification_url": "https://auth.acme.example/device", "redirect_uri": "https://auth.acme.example/device/callback"}}
      ],
      "models": [{"id": "acme-large-2", "title": "Acme Large 2"}],
      "limit_windows": ["five_hour", "seven_day"],
      "key_lifetime_days": 365
    }
  },
  "egress_hosts": ["api.acme.example"]
}
