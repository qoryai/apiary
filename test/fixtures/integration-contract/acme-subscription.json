{
  "version": 1,
  "name": "acme-subscription",
  "title": "Acme subscription",
  "description": "Models of an Acme subscription, whose use Acme limits per window.",
  "settings": {"type": "object"},
  "roles": {
    "model_provider": {
      "apis": [
        {"format": "anthropic-messages", "endpoint": "https://api.acme.example", "auth": {"scheme": "bearer", "oauth": true}}
      ],
      "models": [{"id": "acme-large-2", "title": "Acme Large 2"}],
      "limit_windows": ["five_hour", "seven_day"]
    }
  },
  "egress_hosts": ["api.acme.example"]
}
