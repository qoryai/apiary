{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pull request, version 1",
  "description": "The change of a Build run: title, text, commits and steps.",
  "type": "object",
  "required": [
    "target",
    "title",
    "text",
    "commits",
    "head",
    "base",
    "branch",
    "base_branch",
    "steps",
    "draft"
  ],
  "additionalProperties": false,
  "properties": {
    "target": {
      "title": "Target",
      "$ref": "#/$defs/reference"
    },
    "title": {
      "title": "Title",
      "$ref": "#/$defs/title"
    },
    "text": {
      "title": "Description",
      "$ref": "#/$defs/text"
    },
    "commits": {
      "title": "Commits",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/commit"
      },
      "x-qory-fill": "pushed-commits"
    },
    "head": {
      "title": "Head commit",
      "$ref": "#/$defs/commit",
      "x-qory-fill": "pushed-head"
    },
    "base": {
      "title": "Base commit",
      "$ref": "#/$defs/commit",
      "x-qory-fill": "pushed-base"
    },
    "branch": {
      "title": "Branch",
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^\\x00-\\x20\\x7f~^:?*\\[\\\\/-][^\\x00-\\x20\\x7f~^:?*\\[\\\\]*$",
      "not": {
        "pattern": "\\.\\.|//|@\\{|(^|/)\\.|\\.lock(/|$)|[./]$|^@$"
      },
      "allOf": [
        {
          "$ref": "#/$defs/line"
        }
      ],
      "x-qory-fill": "pushed-branch"
    },
    "base_branch": {
      "title": "Base branch",
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^\\x00-\\x20\\x7f~^:?*\\[\\\\/-][^\\x00-\\x20\\x7f~^:?*\\[\\\\]*$",
      "not": {
        "pattern": "\\.\\.|//|@\\{|(^|/)\\.|\\.lock(/|$)|[./]$|^@$"
      },
      "allOf": [
        {
          "$ref": "#/$defs/line"
        }
      ],
      "x-qory-fill": "pushed-base-branch"
    },
    "earlier_commits": {
      "title": "Earlier commits",
      "type": "integer",
      "minimum": 1,
      "x-qory-fill": "pushed-commits-left-out"
    },
    "steps": {
      "title": "Steps",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "step"
        ],
        "additionalProperties": false,
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "step": {
            "type": "string",
            "$ref": "#/$defs/line",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "draft": {
      "title": "Draft",
      "type": "boolean",
      "const": true
    }
  },
  "$defs": {
    "line": {
      "$ref": "https://qory.dev/contracts/harness/v1/primitives.schema.json#/$defs/line"
    },
    "title": {
      "$ref": "https://qory.dev/contracts/harness/v1/primitives.schema.json#/$defs/title"
    },
    "text": {
      "$ref": "https://qory.dev/contracts/harness/v1/primitives.schema.json#/$defs/text",
      "not": {
        "pattern": "(^|\\n)<!-- qory:(start|end) -->"
      }
    },
    "reference": {
      "$ref": "https://qory.dev/contracts/harness/v1/primitives.schema.json#/$defs/reference"
    },
    "commit": {
      "description": "A commit: the repository is the collection, the commit id is the path.",
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "properties": {
                "path": {
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                }
              }
            }
          }
        }
      ]
    }
  }
}
