<Layouts.auth flash={@flash}>
  <Layouts.auth_heading>
    {gettext("Welcome to Qory Apiary")}
    <:subtitle>
      {gettext(
        "Add your machines as nodes, connect each with a key of its own, and every run they make lands here."
      )}
    </:subtitle>
  </Layouts.auth_heading>
  <div class="grid gap-2">
    <.button variant="primary" size="md" class="btn-block" navigate={~p"/users/log-in"}>
      {gettext("Log in")}
    </.button>
    <.button :if={@sign_up?} size="md" class="btn-block" navigate={~p"/users/register"}>
      {gettext("Create an account")}
    </.button>
  </div>
  <p class="mt-1 text-center text-[13px]/[18px] text-muted">
    <.link id="home-docs" href={~p"/docs"} class="q-link inline-flex items-center gap-1.5">
      <.icon name="hero-book-open" class="size-4" />{gettext("Docs")}
    </.link>
  </p>
</Layouts.auth>
