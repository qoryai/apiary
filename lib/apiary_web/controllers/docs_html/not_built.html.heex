<Layouts.auth flash={@flash} current_scope={@current_scope}>
  <div id="docs-not-built">
    <.empty_state
      icon="hero-book-open"
      tone="neutral"
      heading="h1"
      title={gettext("The documentation is not built")}
    >
      {coded(
        pgettext(
          "plain",
          "A release image builds it and serves it here. In a checkout, run `mix docs` and reload this page. The guides are also in the `guides` directory of the repository, as Markdown."
        ),
        "q-rule"
      )}
      <:actions>
        <.button navigate={~p"/"}>{gettext("Back to Qory Apiary")}</.button>
      </:actions>
    </.empty_state>
  </div>
</Layouts.auth>
