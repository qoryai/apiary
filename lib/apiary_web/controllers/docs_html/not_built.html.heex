<Layouts.auth flash={@flash} current_scope={@current_scope}>
  <div id="docs-not-built">
    <.empty_state
      icon="hero-book-open"
      tone="neutral"
      heading="h1"
      title={gettext("The documentation is not built")}
    >
      <div class="grid gap-2.5">
        <p id="docs-not-built-run">
          {pgettext("plain", "A release image builds it and serves it here. In a checkout, run:")}
        </p>
        <.command_line id="docs-not-built-command" command="mix docs" />
        <p id="docs-not-built-reload">
          <.rich text={
            rich_pgettext(
              "plain",
              "Then reload this page. The guides are also in the %{directory} directory of the repository, as Markdown.",
              directory: {:code, "guides"}
            )
          } />
        </p>
      </div>
      <:actions>
        <.button navigate={~p"/"}>
          {gettext("Back to %{name}", name: Apiary.ProductName.name())}
        </.button>
      </:actions>
    </.empty_state>
  </div>
</Layouts.auth>
