#!/bin/sh
# Sourced by the release script, bin/apiary, before every command, with RELEASE_ROOT,
# RELEASE_NAME and RELEASE_COMMAND set. Erlang distribution is off unless
# DNS_CLUSTER_QUERY is set: releases/distribution.sh, from rel/overlays, says how, and
# bin/server sources the same file.
. "$RELEASE_ROOT/releases/distribution.sh"
