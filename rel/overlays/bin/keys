#!/bin/sh
# Generates the keys the release needs, once: SECRET_KEY_BASE, APIARY_ENCRYPTION_SECRET,
# APIARY_SIGNING_SECRET and DATABASE_PASSWORD, in $APIARY_KEYS_DIR/apiary.env (mode 0600,
# one NAME=value line each, read by config/runtime.exs through Apiary.KeysFile). A name set
# in the environment is skipped, and the environment wins at boot; a name the file holds
# is kept and never changed; any other is generated with openssl. The database password,
# the environment's or the file's, is also written to $APIARY_KEYS_DIR/postgres-password
# (mode 0644), for the postgres image's POSTGRES_PASSWORD_FILE.
#
# With QORY_REGISTRY set and not blank, for the opt-in feature registry: the registry
# signing key, an ECDSA P-256 key in PEM, in $APIARY_KEYS_DIR/registry-token.key (mode
# 0600), generated once and never changed; and, with APIARY_REGISTRY_CERT_DIR set and not
# blank, a self-signed certificate of that key in $APIARY_REGISTRY_CERT_DIR/
# registry-token.crt (mode 0644), on a volume the registry mounts read-only, written again
# whenever its public key is not the key's. That directory is refused when it is
# $APIARY_KEYS_DIR or inside it. The registry reads the certificate only when
# it starts and holds one, so a rotation is: delete registry-token.key, run this again,
# restart Qory Apiary, then restart the registry.
#
# POSIX sh and openssl, no BEAM: config/runtime.exs refuses to start without these keys.
# Each file is written to a temporary file beside it and renamed once whole, so a crash
# leaves no half file. Prints names and paths, never a value; exits non-zero when it
# cannot write.
set -eu
umask 077

dir=${APIARY_KEYS_DIR:?}
file=$dir/apiary.env
password_file=$dir/postgres-password
registry_key=$dir/registry-token.key
newline='
'

# fail OUTPUT: stops, with the reason the failed command gave (what follows its last ": "),
# or a reason of its own when that command printed none.
fail() {
  rm -f "$file.tmp" "$password_file.tmp" "$registry_key.tmp" 2>/dev/null || true
  reason=${1##*: }
  printf 'Cannot write %s: %s. The volume keys has to be writable by the user 65532.\n' \
    "$dir" "${reason:-the write did not complete}" >&2
  exit 1
}

# held NAME: the value the file holds for NAME, from its first line NAME=value, read as
# Apiary.KeysFile reads it.
held() {
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
    "$1"=?*)
      printf '%s' "${line#*=}"
      return 0
      ;;
    esac
  done <"$file"
}

# write PATH MODE CONTENT: CONTENT in PATH, through PATH.tmp, created afresh and renamed
# into place once written. printf is a builtin, so no value reaches a command line. The
# first sync puts the whole file on disk before the rename; the second puts the rename on
# disk before this run ends, so a power loss cannot undo it and leave the next run to
# remove the whole temporary file and generate new keys.
write() {
  output=$({
    rm -f "$1.tmp" &&
      (set -C && printf '%s' "$3" >"$1.tmp") &&
      chmod "$2" "$1.tmp" &&
      sync &&
      mv -f "$1.tmp" "$1" &&
      sync
  } 2>&1) || fail "$output"
}

# A temporary file left by a run that crashed is never read, only removed.
rm -f "$file.tmp" "$password_file.tmp" "$registry_key.tmp" 2>/dev/null || true

content=
generated=
kept=
database_password=

for name in SECRET_KEY_BASE APIARY_ENCRYPTION_SECRET APIARY_SIGNING_SECRET DATABASE_PASSWORD; do
  eval "set_value=\${$name:-}"
  value=$(held "$name")

  if [ -n "$set_value" ] && [ -n "$value" ]; then
    printf '%s is set in the environment, which wins; the file keeps its value.\n' "$name"
  elif [ -n "$set_value" ]; then
    printf '%s is set in the environment: not generated, not kept here.\n' "$name"
  elif [ -n "$value" ]; then
    kept=yes
  else
    case $name in
    SECRET_KEY_BASE) value=$(openssl rand -base64 48) ;;
    DATABASE_PASSWORD) value=$(openssl rand -hex 24) ;;
    *) value=$(openssl rand -base64 32) ;;
    esac
    generated="$generated $name"
  fi

  # A value the file holds stays in it, also when the environment sets the name.
  if [ -n "$value" ]; then
    content="$content$name=$value$newline"
  fi

  if [ "$name" = DATABASE_PASSWORD ]; then
    database_password=${set_value:-$value}
  fi
done

if [ -n "$generated" ]; then
  write "$file" 600 "$content"

  # "A, B, C and D"
  set -- $generated
  list=$1
  shift
  while [ "$#" -gt 1 ]; do
    list="$list, $1"
    shift
  done
  if [ "$#" -eq 1 ]; then
    list="$list and $1"
  fi

  printf 'Generated %s in %s.\n' "$list" "$file"
  printf 'Keep a copy apart from the database backups: without APIARY_ENCRYPTION_SECRET no access key is trusted. To print the file: docker compose exec apiary cat %s\n' "$file"
elif [ -n "$kept" ]; then
  printf 'The keys in %s are kept; none was generated.\n' "$file"
fi

# postgres-password is mode 0644, not 0600: the postgres container reads it as its own user,
# uid 999, not the user 65532 who writes it. It holds only the database password, which
# that container holds already. On the host the volume is reachable only by root, under
# /var/lib/docker. A group shared with postgres would tie this script to the postgres
# image's gid. When DATABASE_PASSWORD is set in the environment, that value is the one
# written here, since it is the password Qory connects with.
if [ ! -f "$password_file" ] || [ "$(cat "$password_file")" != "$database_password" ]; then
  write "$password_file" 644 "$database_password$newline"
fi

# The registry signing key, where QORY_REGISTRY is set: generated once, never changed.
if [ -n "${QORY_REGISTRY:-}" ]; then
  if [ ! -f "$registry_key" ]; then
    output=$(openssl ecparam -name prime256v1 -genkey -noout 2>&1) || fail "$output"
    write "$registry_key" 600 "$output$newline"
    printf 'Generated %s in %s.\n' registry-token.key "$dir"
  fi

  # Its certificate, where APIARY_REGISTRY_CERT_DIR is set, written through a temporary
  # file and a rename when its public key is not the key's. The directory is never the
  # keys directory, inside it or a parent of it, both resolved, since the registry reads
  # it. A failure says which directory, without the keys volume's sentence.
  cert_dir=${APIARY_REGISTRY_CERT_DIR:-}
  if [ -n "$cert_dir" ]; then
    # cert_fail REASON: stops, with the reason after the last ": " of REASON.
    cert_fail() {
      rm -f "$cert_dir/registry-token.crt.tmp" 2>/dev/null || true
      reason=${1##*: }
      printf 'Make %s writable by the user 65532, or set APIARY_REGISTRY_CERT_DIR to a directory that the user 65532 can write. Writing failed: %s.\n' \
        "$cert_dir" "${reason:-the write did not complete}" >&2
      exit 1
    }

    keys_real=$(cd "$dir" 2>&1 && pwd -P) || fail "$keys_real"
    cert_real=$(cd "$cert_dir" 2>&1 && pwd -P) || cert_fail "$cert_real"
    keys_prefix=${keys_real%/}/
    cert_prefix=${cert_real%/}/
    case "$cert_prefix" in "$keys_prefix"*) cert_inside=1 ;; *) cert_inside= ;; esac
    case "$keys_prefix" in "$cert_prefix"*) cert_parent=1 ;; *) cert_parent= ;; esac
    if [ -n "$cert_inside" ] || [ -n "$cert_parent" ]; then
      printf 'Set APIARY_REGISTRY_CERT_DIR to a directory other than %s. Zot reads that directory, and %s contains the private keys.\n' \
        "$dir" "$dir" >&2
      exit 1
    fi

    cert=$cert_dir/registry-token.crt
    rm -f "$cert.tmp" 2>/dev/null || true
    public=$(openssl pkey -in "$registry_key" -pubout 2>&1) || fail "$public"
    held_public=
    if [ -f "$cert" ]; then
      held_public=$(openssl x509 -in "$cert" -noout -pubkey 2>/dev/null) || held_public=
    fi
    if [ "$public" != "$held_public" ]; then
      # openssl writes the certificate to stdout. The shell creates the temporary file
      # with mode 0644 from the umask; set -C makes that create fail where a file, or a
      # link to a file or to no file, has the name. The rm -f after the directory check
      # removes the temporary file a crash left.
      pem=$(openssl req -new -x509 -key "$registry_key" -sha256 -days 3650 -subj "/CN=Qory Apiary registry tokens" 2>&1) || cert_fail "$pem"
      output=$({ (umask 022 && set -C && printf '%s\n' "$pem" >"$cert.tmp") && sync && mv -f "$cert.tmp" "$cert" && sync; } 2>&1) || cert_fail "$output"
      printf 'Generated %s in %s.\n' registry-token.crt "$cert_dir"
    fi
  fi
fi
